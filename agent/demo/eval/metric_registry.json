      },
      "owner": "rag-safety-owner",
      "grader_id": "citation_resolve_rate",
      "grader_version": "1",
      "grader_layer": "L1_programmatic",
      "dataset_segment": "rag_core",
      "measurement": "aggregate.citation_resolve_rate",
      "threshold_or_budget": {
        "mode": "gate",
        "operator": "eq",
        "value": 1.0,
        "unit": "ratio"
      },
      "decision_action": ["block_deploy", "rollback"],
      "cost_class": "near_zero",
      "run_cadence": "per_pr",
      "retirement_condition": "Retire only when the citation-resolution constraint is formally removed.",
      "status": "active",
      "introduced_at": "2026-08-21",
      "last_reviewed_at": "2026-08-21"
    },
