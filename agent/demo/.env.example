# Copy this file to demo/.env, then edit values for your environment.

# Text embedding: deterministic, auto, or openai.
EMBEDDING_PROVIDER=deterministic
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_TIMEOUT_SECONDS=30

# Image embedding: deterministic (offline) or dinov3 (real image features).
IMAGE_EMBEDDING_PROVIDER=deterministic
IMAGE_EMBEDDING_MAX_BYTES=20971520
DINOV3_MODEL=facebook/dinov3-vitb16-pretrain-lvd1689m
DINOV3_DEVICE=cpu
DINOV3_LOCAL_FILES_ONLY=false
# Required when the gated model is not already available in the local cache.
HF_TOKEN=

# Query classification: rule_based, auto, or openai.
QUERY_CLASSIFIER=auto
OPENAI_CLASSIFIER_MODEL=
OPENAI_CLASSIFIER_TIMEOUT_SECONDS=10

# Evidence reranking: rule_based, auto, or openai.
RERANKER=auto
OPENAI_RERANKER_MODEL=
OPENAI_RERANKER_TIMEOUT_SECONDS=10

# Answer generation: deterministic, auto, or openai.
ANSWER_GENERATOR=auto
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=30

# Object-store source used only with ingest_demo.py --s3-source minio.
# Credentials are intentionally environment-only and have no CLI flags.
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=internal-agent-chat-demo
MINIO_PREFIX=
MINIO_SECURE=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_MAX_OBJECTS=1000
MINIO_MAX_OBJECT_BYTES=16777216

# Milvus connection used by provisioning, ingestion, and Streamlit.
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION_NAME=kb_chunks
MILVUS_MEMORY_COLLECTION_NAME=conversation_memory
MILVUS_MEMORY_EVENTS_COLLECTION_NAME=memory_events
MILVUS_MEMORY_FACTS_COLLECTION_NAME=memory_facts
MILVUS_MEMORY_CONSOLIDATION_JOURNAL_COLLECTION_NAME=memory_consolidation_journal
MEMORY_CLEANUP_CURSOR_SECRET=replace-with-at-least-32-random-bytes
MILVUS_RESPONSE_CACHE_COLLECTION_NAME=grounded_response_cache

# Session-scoped semantic Memory.
MEMORY_TOP_K=3
MEMORY_TTL_SECONDS=86400

# Selective dual-speed Memory. `milvus` runs a fail-closed, read-only startup
# acceptance probe for exp/gauss/linear; keep application for offline fallback.
SELECTIVE_MEMORY_ENABLED=true
MEMORY_LANE_TOP_K=3
MEMORY_PACK_MAX_RECORDS=12
MEMORY_CONTEXT_MAX_CHARS=4000
MEMORY_CONSOLIDATION_BATCH_SIZE=20
MEMORY_RECURRENCE_THRESHOLD=2
MEMORY_DECAY_MODE=application
# Optional ambiguity-only selector. It never overrides explicit protected rules.
MEMORY_SELECTOR=rule_based
MEMORY_SELECTOR_AMBIGUITY_MIN=0.40
MEMORY_SELECTOR_AMBIGUITY_MAX=0.60
OPENAI_MEMORY_SELECTOR_MODEL=
OPENAI_MEMORY_SELECTOR_TIMEOUT_SECONDS=5

# Grounded response reuse. Bump KB_REVISION after publishing KB changes.
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_TOP_K=3
RESPONSE_CACHE_TTL_SECONDS=259200
RESPONSE_CACHE_SIMILARITY_THRESHOLD=0.92
KB_REVISION=demo-v1
