# Copy this file to demo/.env, then edit values for your environment.

# Text embedding: deterministic, auto, or openai.
EMBEDDING_PROVIDER=deterministic
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_TIMEOUT_SECONDS=30

# Answer generation: deterministic, auto, or openai.
ANSWER_GENERATOR=auto
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=30

# Milvus connection used by provisioning, ingestion, and Streamlit.
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION_NAME=kb_chunks
MILVUS_MEMORY_COLLECTION_NAME=conversation_memory

# Session-scoped semantic Memory.
MEMORY_TOP_K=3
MEMORY_TTL_SECONDS=86400
