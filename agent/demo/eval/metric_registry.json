{
  "registry_version": "eval-metric-registry-v1",
  "metrics": [
    {
      "metric_id": "goal.retrieval_recall_at_20",
      "role": "goal",
      "question": "Did retrieval recall the expected sources in the first 20 results?",
      "source": {
        "kind": "product_goal",
        "ref": "specs/70-quality-and-evaluation.md#40a-initial-active-registry"
      },
      "owner": "retrieval-owner",
      "grader_id": "retrieval_recall_at_20",
      "grader_version": "1",
      "grader_layer": "L1_programmatic",
      "dataset_segment": "rag_core",
      "measurement": "aggregate.recall_at_k",
      "threshold_or_budget": {
        "mode": "gate",
        "operator": "gte",
        "value": 0.9,
        "unit": "ratio"
      },
      "decision_action": ["reject_change", "open_investigation"],
      "cost_class": "near_zero",
      "run_cadence": "per_pr",
      "retirement_condition": "Review after 90 days at 100% without changing a retrieval decision.",
      "status": "active",
      "introduced_at": "2026-08-21",
      "last_reviewed_at": "2026-08-21"
    },
    {
